<?xml version="1.0" encoding="utf-8"?>
<!-- Seção das Configurações: foco = anel roxo; em exibição (activated) = fundo claro + barra roxa; as duas juntas somam. A barra segue o filete do episódio "A seguir" (episode_next_bg). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/lf_surface_hi" />
                    <stroke android:width="2dp" android:color="@color/lf_accent" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:width="4dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lf_accent" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_surface_hi" />
            <stroke android:width="2dp" android:color="@color/lf_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/lf_surface_hi" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:width="4dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lf_accent" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /></shape></item>
</selector>
