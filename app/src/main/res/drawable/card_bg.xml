<?xml version="1.0" encoding="utf-8"?>
<!-- Botão/chip/dock: foco = anel roxo sobre fundo escuro (texto continua legível). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_surface_hi" />
            <stroke android:width="2dp" android:color="@color/lf_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_surface" />
            <stroke android:width="1dp" android:color="@color/lf_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
