<?xml version="1.0" encoding="utf-8"?>
<!-- Botão de ação principal (um por tela): roxo cheio; foco = anel claro. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_primary" />
            <stroke android:width="3dp" android:color="@color/lf_text" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_primary_dark" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
