<?xml version="1.0" encoding="utf-8"?>
<!-- Anel de foco desenhado por cima do cartão (primeiro plano), sem aumentar nem preencher. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="@color/lf_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /></shape></item>
</selector>
