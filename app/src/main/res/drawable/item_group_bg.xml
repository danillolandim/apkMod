<?xml version="1.0" encoding="utf-8"?>
<!-- Categoria atual (marcada como "ativada" pela lista): fundo discreto com barra roxa. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/lf_surface_hi" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:left="0dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/lf_accent" />
                    <size android:width="4dp" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /></shape></item>
</selector>
