<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão grande da Home: superfície em repouso; foco = roxo da marca com anel de destaque. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_primary" />
            <stroke android:width="3dp" android:color="@color/lf_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_primary_dark" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lf_surface" />
            <stroke android:width="1dp" android:color="@color/lf_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
