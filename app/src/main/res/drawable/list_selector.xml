<?xml version="1.0" encoding="utf-8"?>
<!-- Foco de lista: só o anel (sem preenchimento), para o texto nunca ficar escondido. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="@color/lf_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /></shape></item>
</selector>
