<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_subtitle_button="true"
        app:use_controller="true" />

    <!-- Indicador de qualidade/status: aparece 3s ao iniciar, mudar faixa, seek… -->
    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="28dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/badge_bg"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:importantForAccessibility="yes"
        android:visibility="gone" />

    <!-- Barra de info do canal (nome, logo, EPG) — experiência de TV -->
    <LinearLayout
        android:id="@+id/channel_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC05080D"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ch_logo"
            android:layout_width="96dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter"
            android:contentDescription="Logo do canal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ch_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ch_epg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9FB0C0"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- HUD de diagnóstico (liga/desliga pelo botão INFO/azul) -->
    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:padding="10dp"
        android:background="#A6000000"
        android:textColor="#3DFF9E"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />
</FrameLayout>
