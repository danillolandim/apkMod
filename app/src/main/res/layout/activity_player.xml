<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false" />

    <!-- Celular (Device.isTv = falso): pega o toque no vídeo, que o PlayerView sem controlador não trata.
         Fica abaixo de tudo o mais. Escondida e fora do foco na TV. -->
    <View
        android:id="@+id/touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="Mostrar ou esconder os controles"
        android:focusable="false"
        android:soundEffectsEnabled="false"
        android:visibility="gone" />

    <!-- Barra do filme/série (estilo Netflix): título no topo, linha de progresso embaixo, degradês escuros em vez de
         caixa sólida. Nada aqui recebe foco: na TV as teclas são tratadas pela Activity (onKeyDown). Escondida até uma
         tecla (ou toque) chamá-la. clipChildren=false: o balão do tempo desenha acima da linha. -->
    <FrameLayout
        android:id="@+id/vod_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/vod_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/vod_scrim_top"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="28dp"
            android:paddingEnd="56dp"
            android:paddingBottom="56dp">

            <TextView
                android:id="@+id/vod_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/rajdhani_semibold"
                android:maxLines="1"
                android:textColor="@color/lf_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/vod_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/rajdhani_semibold"
                android:maxLines="1"
                android:textColor="@color/lf_text_2"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Pulso no centro ao pausar ou continuar (só na TV; no celular o botão central mostra o estado) -->
        <ImageView
            android:id="@+id/vod_pulse"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/vod_pulse_bg"
            android:importantForAccessibility="no"
            android:padding="28dp"
            android:src="@drawable/ic_pause"
            android:visibility="gone" />

        <!-- Celular (Device.isTv = falso): voltar N s, pausar/continuar e avançar N s no centro. Alvos de 64 e 72dp.
             Escondido na TV. O número do pulo é o das Configurações (Pulo das setas), escrito pelo código. -->
        <LinearLayout
            android:id="@+id/vod_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/vod_back_btn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Voltar 10 segundos"
                android:focusable="false">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_replay" />

                <TextView
                    android:id="@+id/vod_back_n"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/rajdhani_bold"
                    android:importantForAccessibility="no"
                    android:paddingTop="5dp"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </FrameLayout>

            <ImageView
                android:id="@+id/vod_play_btn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/vod_btn_bg"
                android:clickable="true"
                android:contentDescription="Pausar"
                android:focusable="false"
                android:padding="20dp"
                android:src="@drawable/ic_pause" />

            <FrameLayout
                android:id="@+id/vod_fwd_btn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Avançar 10 segundos"
                android:focusable="false">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_forward" />

                <TextView
                    android:id="@+id/vod_fwd_n"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/rajdhani_bold"
                    android:importantForAccessibility="no"
                    android:paddingTop="5dp"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vod_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/vod_scrim_bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="72dp"
            android:paddingEnd="56dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/vod_line_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Estado em ícone E em texto (contentDescription): "Pausado" / "Reproduzindo" -->
                <ImageView
                    android:id="@+id/vod_state"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Reproduzindo"
                    android:src="@drawable/ic_pause"
                    android:visibility="gone" />

                <com.seupainel.player.VodTimeBar
                    android:id="@+id/vod_progress"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/vod_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:gravity="end"
                    android:maxLines="1"
                    android:minWidth="84dp"
                    android:textColor="@color/lf_text"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Tempo decorrido; "Carregando…" fica ao lado (só aparece enquanto o vídeo carrega) para a barra não pular de altura -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/vod_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:maxLines="1"
                    android:textColor="@color/lf_text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/vod_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:maxLines="1"
                    android:text="Carregando…"
                    android:textColor="@color/lf_text_2"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Fileira de botões (só na TV; o código a mostra). O ícone do ▶/❚❚ recua 7dp para alinhar com o início do trilho. Foco "virtual": ninguém aqui recebe foco do Android, a
                 Activity marca o escolhido com isSelected e ele só muda de cor (sem anel e sem fundo, ver color/vod_row_content).
                 isSelected no contêiner passa para o ícone e o texto dentro dele. -->
            <LinearLayout
                android:id="@+id/vod_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/vod_row_play"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-7dp"
                    android:contentDescription="Pausar"
                    android:focusable="false"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:src="@drawable/ic_pause"
                    android:tint="@color/vod_row_content" />

                <LinearLayout
                    android:id="@+id/vod_row_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Áudio e legendas"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_subtitles"
                        android:tint="@color/vod_row_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/rajdhani_semibold"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="Áudio e legendas"
                        android:textColor="@color/vod_row_content"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/vod_row_next"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Próximo episódio"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/vod_row_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/rajdhani_semibold"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="Próximo episódio"
                        android:textColor="@color/vod_row_content"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/vod_row_more"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Mais opções"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_gear"
                        android:tint="@color/vod_row_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/rajdhani_semibold"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="Mais opções"
                        android:textColor="@color/vod_row_content"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Indicador de qualidade/status: aparece 3s ao iniciar, mudar faixa, seek… -->
    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="28dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/badge_bg"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:importantForAccessibility="yes"
        android:visibility="gone" />

    <!-- Aviso de "próximo episódio em N" nos últimos segundos (séries) -->
    <TextView
        android:id="@+id/next_ep_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="40dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/badge_bg"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Faixa do canal (ao vivo): número, logo, nome, programa atual com progresso e "a seguir".
         Não é focável: o controle zapeia, e quem lê o canal é o anúncio do TalkBack (announce). -->
    <LinearLayout
        android:id="@+id/channel_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/channel_bar_bg"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ch_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:gravity="center"
            android:fontFamily="@font/rajdhani_bold"
            android:textColor="@color/lf_accent"
            android:textSize="34sp"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ch_logo"
            android:layout_width="96dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Logo do canal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ch_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_semibold"
                android:textColor="@color/lf_text"
                android:textSize="24sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Estado do canal em texto (não só cor): "Sintonizando…", erro, dica de uso -->
            <TextView
                android:id="@+id/ch_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/lf_text_2"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ch_epg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/lf_text"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ProgressBar
                android:id="@+id/ch_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progressDrawable="@drawable/channel_progress"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ch_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/lf_text_2"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Qualidade atual (só no ao vivo com várias qualidades). Indicador: a troca é pelo OK (dock). -->
        <TextView
            android:id="@+id/quality_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/card_bg"
            android:focusable="false"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false"
            android:fontFamily="@font/rajdhani_semibold"
            android:text="Qualidade"
            android:textColor="@color/card_text"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Controles por toque (celular, Device.isTv = falso). Escondida e sem foco na TV. Ao vivo, um toque na tela a
         mostra por 5 s; no filme ela acompanha a barra própria (vod_bar) e só traz Opções e Transmitir. -->
    <LinearLayout
        android:id="@+id/touch_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/channel_bar_bg"
        android:descendantFocusability="blocksDescendants"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Só no ao vivo com lista de canais (sessão carregada) -->
        <LinearLayout
            android:id="@+id/tb_zap_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tb_channels"
                style="@style/TouchBarButton"
                android:text="Canais" />

            <TextView
                android:id="@+id/tb_prev"
                style="@style/TouchBarButton"
                android:contentDescription="Canal anterior"
                android:text="‹ Canal" />

            <TextView
                android:id="@+id/tb_next"
                style="@style/TouchBarButton"
                android:contentDescription="Próximo canal"
                android:text="Canal ›" />
        </LinearLayout>

        <TextView
            android:id="@+id/tb_options"
            style="@style/TouchBarButton"
            android:text="Opções" />

        <TextView
            android:id="@+id/tb_cast"
            style="@style/TouchBarButton"
            android:contentDescription="Transmitir para a TV"
            android:drawableStart="@drawable/ic_cast"
            android:text="Transmitir" />
    </LinearLayout>

    <!-- Lista de canais sobre o vídeo (ao vivo): categorias + canais à esquerda; à direita, embaixo, a
         programação do canal em foco. O vídeo continua tocando por trás. -->
    <LinearLayout
        android:id="@+id/live_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/live_left_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="45"
            android:orientation="horizontal"
            android:background="@drawable/live_panel_bg"
            android:paddingLeft="28dp"
            android:paddingRight="12dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <ListView
                android:id="@+id/live_groups"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="36"
                android:choiceMode="singleChoice"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:drawSelectorOnTop="true"
                android:listSelector="@drawable/list_selector"
                android:contentDescription="Categorias de canais"
                android:padding="4dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="64">

                <ListView
                    android:id="@+id/live_channels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:drawSelectorOnTop="true"
                    android:listSelector="@drawable/list_selector"
                    android:contentDescription="Canais"
                    android:padding="4dp" />

                <!-- Categoria sem canais -->
                <TextView
                    android:id="@+id/live_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Nenhum canal nesta categoria"
                    android:textColor="@color/lf_text_2"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="55">

            <LinearLayout
                android:id="@+id/live_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="28dp"
                android:layout_marginRight="40dp"
                android:layout_marginBottom="32dp"
                android:orientation="vertical"
                android:background="@drawable/channel_bar_bg"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/live_guide_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:textColor="@color/lf_text"
                    android:textSize="22sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/live_guide_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/lf_text"
                    android:textSize="16sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <ProgressBar
                    android:id="@+id/live_guide_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/channel_progress"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/live_guide_next_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:text="A seguir"
                    android:textColor="@color/lf_accent"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/live_guide_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/lf_text_2"
                    android:textSize="14sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Dock de ações (sobe de baixo, estilo dock do Mac) -->
    <LinearLayout
        android:id="@+id/player_dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/dialog_bg"
        android:visibility="gone">

        <TextView android:id="@+id/dock_quality" style="@style/DockItem" />
        <TextView android:id="@+id/dock_audio" style="@style/DockItem" />
        <TextView android:id="@+id/dock_sub" style="@style/DockItem" />
        <TextView android:id="@+id/dock_aspect" style="@style/DockItem" />
        <TextView android:id="@+id/dock_speed" style="@style/DockItem" />
        <TextView android:id="@+id/dock_timer" style="@style/DockItem" />
        <TextView android:id="@+id/dock_pip" style="@style/DockItem" />
    </LinearLayout>

    <!-- HUD de diagnóstico (liga/desliga pelo botão INFO/azul) -->
    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:padding="10dp"
        android:background="#A6000000"
        android:textColor="#3DFF9E"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />
</FrameLayout>
