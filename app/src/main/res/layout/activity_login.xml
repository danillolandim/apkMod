<?xml version="1.0" encoding="utf-8"?>
<!-- Primeiro uso: marca à esquerda; usuário e senha à direita (o servidor já vem de fábrica). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper_landimflix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="170dp"
                android:adjustViewBounds="true"
                android:contentDescription="Landimflix"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_full" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="O guia definitivo para os amantes do cinema"
                android:textColor="@color/lf_text_2"
                android:textSize="15sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="48dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/rammetto_one"
                    android:text="Acesse sua conta"
                    android:textColor="@color/lf_text"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Use o usuário e a senha que o seu provedor enviou."
                    android:textColor="@color/lf_text_2"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/login_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="Usuário"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:nextFocusDown="@+id/login_pass"
                    android:singleLine="true"
                    android:textColor="@color/lf_text"
                    android:textColorHint="@color/lf_text_3" />

                <EditText
                    android:id="@+id/login_pass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Senha"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/lf_text"
                    android:textColorHint="@color/lf_text_3" />

                <CheckBox
                    android:id="@+id/login_show_pass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mostrar senha"
                    android:textColor="@color/lf_text_2" />

                <TextView
                    android:id="@+id/login_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:minHeight="40dp"
                    android:textColor="@color/lf_text_2"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/login_enter"
                    style="@style/TvButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Entrar"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/login_toggle_advanced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Opções avançadas"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/login_advanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Servidor (DNS)"
                        android:textColor="@color/lf_accent"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/login_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="http://servidor.com:8080"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="@color/lf_text"
                        android:textColorHint="@color/lf_text_3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Servidor alternativo (opcional, usado se o principal falhar)"
                        android:textColor="@color/lf_accent"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/login_alt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="@color/lf_text"
                        android:textColorHint="@color/lf_text_3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Chave do TMDB própria (opcional)"
                        android:textColor="@color/lf_accent"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/login_tmdb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Deixe vazio para usar a do app"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true"
                        android:textColor="@color/lf_text"
                        android:textColorHint="@color/lf_text_3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="A chave do app já traz sinopse, Aclamadas e Populares. Se preferir a sua: themoviedb.org > Configurações > API."
                        android:textColor="@color/lf_text_3"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/login_m3u"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tenho só uma lista M3U"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
