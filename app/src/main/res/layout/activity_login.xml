<?xml version="1.0" encoding="utf-8"?>
<!-- Primeiro uso: marca à esquerda; usuário e senha à direita (o servidor já vem de fábrica). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper_landimflix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="170dp"
                android:adjustViewBounds="true"
                android:contentDescription="Landimflix"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_full" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="O guia definitivo para os amantes do cinema"
                android:textColor="@color/lf_text_2"
                android:textSize="15sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="28dp"
                android:paddingEnd="56dp"
                android:paddingBottom="28dp">

                <!-- O formulário num painel só: rótulo em cima de cada campo, 48dp de altura, respiro entre os grupos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/rammetto_one"
                        android:text="Acesse sua conta"
                        android:textColor="@color/lf_text"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Use o usuário e a senha que o seu provedor enviou."
                        android:textColor="@color/lf_text_2"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/FormLabel"
                        android:layout_marginTop="20dp"
                        android:labelFor="@+id/login_user"
                        android:text="Usuário" />

                    <EditText
                        android:id="@+id/login_user"
                        style="@style/FormField"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:nextFocusDown="@+id/login_pass"
                        android:singleLine="true" />

                    <TextView
                        style="@style/FormLabel"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/login_pass"
                        android:text="Senha" />

                    <EditText
                        android:id="@+id/login_pass"
                        style="@style/FormField"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:singleLine="true" />

                    <CheckBox
                        android:id="@+id/login_show_pass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="40dp"
                        android:text="Mostrar senha"
                        android:textColor="@color/lf_text_2" />

                    <!-- Servidor: escondido quando o app já vem com o de fábrica -->
                    <LinearLayout
                        android:id="@+id/login_advanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/FormLabel"
                            android:layout_marginTop="12dp"
                            android:labelFor="@+id/login_server"
                            android:text="Servidor (DNS)" />

                        <EditText
                            android:id="@+id/login_server"
                            style="@style/FormField"
                            android:hint="servidor.com:8080"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:singleLine="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Não precisa digitar http://, só o endereço."
                            android:textColor="@color/lf_text_3"
                            android:textSize="12sp" />

                        <TextView
                            style="@style/FormLabel"
                            android:layout_marginTop="16dp"
                            android:labelFor="@+id/login_alt"
                            android:text="Servidor alternativo (opcional)" />

                        <EditText
                            android:id="@+id/login_alt"
                            style="@style/FormField"
                            android:hint="usado se o principal falhar"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:singleLine="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/login_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityLiveRegion="polite"
                        android:minHeight="40dp"
                        android:textColor="@color/lf_text_2"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/login_enter"
                        style="@style/TvButton.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:text="Entrar"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/login_toggle_advanced"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Opções avançadas"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/login_m3u"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Tenho só uma lista M3U"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
