<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="56dp">

        <ImageView
            android:id="@+id/d_poster"
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:background="#111823"
            android:scaleType="centerCrop"
            android:contentDescription="Cartaz" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="40dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/d_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFC24B"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/d_overview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="18dp"
                android:textColor="#C9D2DC"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/d_watch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:gravity="center"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="▶  Assistir"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
