<?xml version="1.0" encoding="utf-8"?>
<!-- Detalhe do filme no tema Landimflix: arte de fundo, capa com brilho, dados, sinopse e ações. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_bg">

    <ImageView
        android:id="@+id/d_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/detail_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp">

        <!-- Capa com brilho -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <View
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/poster_glow" />

            <ImageView
                android:id="@+id/d_poster"
                android:layout_width="150dp"
                android:layout_height="225dp"
                android:layout_gravity="center"
                android:background="@drawable/poster_card_bg"
                android:clipToOutline="true"
                android:contentDescription="Cartaz"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/rajdhani_bold"
                android:maxLines="2"
                android:textColor="@color/lf_text"
                android:textSize="34sp" />

            <!-- Ano • nota em pílula • situação (ícone + texto) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:textColor="@color/lf_text_2"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/d_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/rating_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star"
                        android:tint="@color/lf_accent" />

                    <TextView
                        android:id="@+id/d_rating_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/rajdhani_bold"
                        android:textColor="@color/lf_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/d_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/watched_badge_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/d_status_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check"
                        android:tint="@color/lf_accent" />

                    <TextView
                        android:id="@+id/d_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/rajdhani_bold"
                        android:textColor="@color/lf_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/d_overview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="9"
                android:textColor="@color/lf_text_2"
                android:textSize="15sp" />

            <!-- Onde parou -->
            <LinearLayout
                android:id="@+id/d_progress_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/d_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="280dp"
                    android:layout_height="5dp"
                    android:importantForAccessibility="no"
                    android:max="100"
                    android:progressDrawable="@drawable/watch_progress" />

                <TextView
                    android:id="@+id/d_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/lf_text_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Ações: um só botão cheio; o resto em anel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d_watch"
                    style="@style/PrimaryButton"
                    android:drawableStart="@drawable/ic_play"
                    android:text="Assistir" />

                <TextView
                    android:id="@+id/d_restart"
                    style="@style/GhostButton"
                    android:layout_marginStart="10dp"
                    android:drawableStart="@drawable/ic_restart"
                    android:text="Recomeçar"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/d_alt"
                    style="@style/GhostButton"
                    android:layout_marginStart="10dp"
                    android:drawableStart="@drawable/ic_play"
                    android:text="Assistir legendado"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d_fav"
                    style="@style/GhostButton"
                    android:drawableStart="@drawable/ic_star_outline"
                    android:text="Favoritar" />

                <TextView
                    android:id="@+id/d_seen"
                    style="@style/GhostButton"
                    android:layout_marginStart="10dp"
                    android:drawableStart="@drawable/ic_check"
                    android:text="Marcar como visto" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
