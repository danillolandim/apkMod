<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper_landimflix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Barra superior: marca, seções (abas) e situação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="36dp"
                android:adjustViewBounds="true"
                android:contentDescription="Landimflix"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_symbol" />

            <Button android:id="@+id/nav_canais" style="@style/NavTab" android:layout_marginStart="22dp" android:text="TV ao vivo" />
            <Button android:id="@+id/nav_filmes" style="@style/NavTab" android:layout_marginStart="6dp" android:text="Filmes" />
            <Button android:id="@+id/nav_series" style="@style/NavTab" android:layout_marginStart="6dp" android:text="Séries" />
            <Button android:id="@+id/nav_fav" style="@style/NavTab" android:layout_marginStart="6dp" android:text="Favoritos" />
            <Button android:id="@+id/nav_search" style="@style/NavTab" android:layout_marginStart="6dp" android:text="Buscar" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/lf_text_3"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Título da seção (como o "Explorar" do Figma) -->
        <TextView
            android:id="@+id/section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/rammetto_one"
            android:text="Explorar"
            android:textColor="@color/lf_text"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Categorias -->
            <ListView
                android:id="@+id/groups"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.85"
                android:background="@drawable/panel_bg"
                android:choiceMode="singleChoice"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:drawSelectorOnTop="true"
                android:listSelector="@drawable/list_selector"
                android:nextFocusRight="@+id/channels"
                android:padding="8dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="3.4">

                <ListView
                    android:id="@+id/channels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/panel_bg"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:drawSelectorOnTop="true"
                    android:listSelector="@drawable/list_selector"
                    android:nextFocusLeft="@+id/groups"
                    android:padding="8dp" />

                <GridView
                    android:id="@+id/channels_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:drawSelectorOnTop="true"
                    android:focusable="true"
                    android:horizontalSpacing="12dp"
                    android:listSelector="@drawable/grid_selector"
                    android:nextFocusLeft="@+id/groups"
                    android:numColumns="6"
                    android:padding="4dp"
                    android:verticalSpacing="12dp"
                    android:visibility="gone" />

                <!-- Estado vazio: ícone + frase -->
                <LinearLayout
                    android:id="@+id/empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_movie"
                        android:tint="@color/lf_text_3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nada por aqui. Que tal tentar outra categoria?"
                        android:textColor="@color/lf_text_3"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Tela de carregamento (sobreposta até a lista ficar pronta) -->
    <FrameLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wallpaper_landimflix"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:adjustViewBounds="true"
                android:contentDescription="Landimflix"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_full" />

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/lf_accent" />

            <TextView
                android:id="@+id/loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Aguarde, carregando o conteúdo…"
                android:textColor="@color/lf_text_2"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
