<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_bg">

    <!-- Fundo da marca (ou papel de parede escolhido nas Configurações) -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_landimflix"
        android:contentDescription="Papel de parede" />

    <!-- Escurecimento para legibilidade sobre fotos -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <!-- Barra superior: marca à esquerda; relógio e configurações à direita -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="40dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:adjustViewBounds="true"
            android:contentDescription="Landimflix"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_symbol" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-condensed"
            android:importantForAccessibility="no"
            android:letterSpacing="0.06"
            android:text="LANDIM"
            android:textColor="@color/lf_text"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:importantForAccessibility="no"
            android:letterSpacing="0.06"
            android:text="FLIX"
            android:textColor="@color/lf_accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="00:00"
                android:textColor="@color/lf_text"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/lf_text_2"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_gear"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/card_bg"
            android:contentDescription="Configurações"
            android:defaultFocusHighlightEnabled="false"
            android:padding="12dp"
            android:src="@drawable/ic_gear" />
    </LinearLayout>

    <!-- Conteúdo: título e os três destinos -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="56dp"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Explorar"
            android:textColor="@color/lf_text"
            android:textSize="46sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="O guia definitivo para os amantes do cinema"
            android:textColor="@color/lf_text_2"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_live"
                android:layout_width="300dp"
                android:layout_height="180dp"
                android:layout_marginStart="0dp"
                android:background="@drawable/tile_bg"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tv"
                    android:tint="@color/tile_icon" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="TV ao vivo"
                    android:textColor="@color/card_text"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="Canais e programação"
                    android:textColor="@color/tile_sub"
                    android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_filmes"
                android:layout_width="300dp"
                android:layout_height="180dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/tile_bg"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_movie"
                    android:tint="@color/tile_icon" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Filmes"
                    android:textColor="@color/card_text"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="Catálogo completo"
                    android:textColor="@color/tile_sub"
                    android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_series"
                android:layout_width="300dp"
                android:layout_height="180dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/tile_bg"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_series"
                    android:tint="@color/tile_icon" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Séries"
                    android:textColor="@color/card_text"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="Temporadas e episódios"
                    android:textColor="@color/tile_sub"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
