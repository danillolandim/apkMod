<?xml version="1.0" encoding="utf-8"?>
<!-- Home simples: marca, relógio, e três botões grandes. Nada aqui é recortado nem escala. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Papel de parede"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_landimflix" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="26dp"
        android:paddingEnd="40dp"
        android:paddingBottom="26dp">

        <!-- Barra superior: marca à esquerda; relógio e configurações à direita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:contentDescription="Landimflix"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_symbol" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_wordmark" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/rajdhani_medium"
                    android:text="00:00"
                    android:textColor="@color/lf_text"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/clock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lf_text_2"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/card_bg"
                android:contentDescription="Buscar"
                android:defaultFocusHighlightEnabled="false"
                android:padding="10dp"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btn_gear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/card_bg"
                android:contentDescription="Configurações"
                android:defaultFocusHighlightEnabled="false"
                android:padding="10dp"
                android:src="@drawable/ic_gear" />
        </LinearLayout>

        <!-- Centro: saudação e os três destinos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_semibold"
                android:text="Olá"
                android:textColor="@color/lf_accent"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/rammetto_one"
                android:text="O que vamos assistir?"
                android:textColor="@color/lf_text"
                android:textSize="26sp" />

            <!-- Folga em volta dos botões: nada encosta na borda da tela nem do container -->
            <LinearLayout
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="6dp">

            <LinearLayout
                android:id="@+id/card_live"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_marginStart="0dp"
                android:layout_weight="1"
                android:background="@drawable/home_tile_bg"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tv"
                        android:tint="@color/lf_accent" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/rajdhani_bold"
                    android:maxLines="1"
                    android:text="TV ao vivo"
                    android:textColor="@color/lf_text"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/card_live_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Canais e programação"
                    android:textColor="@color/lf_text_2"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_filmes"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/home_tile_bg"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_movie"
                        android:tint="@color/lf_accent" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/rajdhani_bold"
                    android:maxLines="1"
                    android:text="Filmes"
                    android:textColor="@color/lf_text"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/card_filmes_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Catálogo completo"
                    android:textColor="@color/lf_text_2"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/card_series"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/home_tile_bg"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_series"
                        android:tint="@color/lf_accent" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/rajdhani_bold"
                    android:maxLines="1"
                    android:text="Séries"
                    android:textColor="@color/lf_text"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/card_series_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Temporadas e episódios"
                    android:textColor="@color/lf_text_2"
                    android:textSize="13sp" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
