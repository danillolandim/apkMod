<?xml version="1.0" encoding="utf-8"?>
<!-- Home fluida: barra com seções, destaque que acompanha o foco e fileiras de cartazes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_bg"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Papel de parede"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_landimflix" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="8dp">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="36dp"
                android:adjustViewBounds="true"
                android:contentDescription="Landimflix"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_symbol" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_wordmark" />

            <Button android:id="@+id/home_tab_live" style="@style/NavTab" android:layout_marginStart="26dp" android:text="TV ao vivo" />
            <Button android:id="@+id/home_tab_movies" style="@style/NavTab" android:layout_marginStart="6dp" android:text="Filmes" />
            <Button android:id="@+id/home_tab_series" style="@style/NavTab" android:layout_marginStart="6dp" android:text="Séries" />
            <Button android:id="@+id/home_tab_fav" style="@style/NavTab" android:layout_marginStart="6dp" android:text="Favoritos" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/rajdhani_medium"
                    android:text="00:00"
                    android:textColor="@color/lf_text"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/clock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lf_text_2"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_gear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/card_bg"
                android:contentDescription="Configurações"
                android:defaultFocusHighlightEnabled="false"
                android:padding="9dp"
                android:src="@drawable/ic_gear" />
        </LinearLayout>

        <!-- Destaque: muda conforme o cartaz em foco -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hero_poster"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:background="@drawable/poster_card_bg"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/rammetto_one"
                    android:maxLines="2"
                    android:textColor="@color/lf_text"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/hero_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/lf_text_2"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/hero_open"
                    style="@style/TvButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="7dp"
                    android:text="Ver detalhes"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/home_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="Carregando seu catálogo…"
            android:textColor="@color/lf_text_2"
            android:textSize="15sp" />

        <!-- Fileiras de cartazes (rolam na vertical; cada fileira rola na horizontal) -->
        <ScrollView
            android:id="@+id/home_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
