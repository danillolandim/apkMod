<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080D">

    <!-- Papel de parede (vetor ou imagem personalizada carregada em runtime) -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper"
        android:contentDescription="Papel de parede" />

    <!-- Escurecimento inferior para legibilidade -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <!-- Relógio / data (topo direito, estilo tvOS) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="64dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:shadowColor="#80000000"
            android:shadowDx="0" android:shadowDy="2" android:shadowRadius="8" />

        <TextView
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:fontFamily="sans-serif-light"
            android:text=""
            android:textColor="#D9FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Engrenagem (canto superior esquerdo) -->
    <ImageButton
        android:id="@+id/btn_gear"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="56dp"
        android:layout_marginStart="56dp"
        android:background="@drawable/card_bg"
                android:defaultFocusHighlightEnabled="false"
        android:contentDescription="Configurações"
        android:padding="12dp"
        android:src="@drawable/ic_gear" />

    <!-- Conteúdo inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingBottom="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="Player Mod"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <!-- Cartões de ação -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/card_channels"
                android:layout_width="260dp"
                android:layout_height="120dp"
                android:background="@drawable/card_bg"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="Meus canais"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/card_settings"
                android:layout_width="260dp"
                android:layout_height="120dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/card_bg"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="Configurações"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/card_test"
                android:layout_width="260dp"
                android:layout_height="120dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/card_bg"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="Testar URL / demos"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
