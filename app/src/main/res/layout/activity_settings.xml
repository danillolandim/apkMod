<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações da lista"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="URL da lista M3U"
            android:textColor="#3DA9FC" />

        <EditText
            android:id="@+id/set_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://…/lista.m3u"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#667080" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="URL de configuração (opcional) — arquivo na nuvem cujo conteúdo é a URL da lista. Trocar a lista por aqui não exige mexer na TV."
            android:textColor="#3DA9FC" />

        <EditText
            android:id="@+id/set_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://…/minha-config.txt"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#667080" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="User-Agent (opcional)"
            android:textColor="#3DA9FC" />

        <EditText
            android:id="@+id/set_ua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="deixe vazio para o padrão"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#667080" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Atualizar a cada (horas) — 0 = só manual"
            android:textColor="#3DA9FC" />

        <EditText
            android:id="@+id/set_refresh"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:singleLine="true"
            android:text="12"
            android:textColor="#FFFFFF" />

        <CheckBox
            android:id="@+id/set_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Abrir a lista automaticamente ao iniciar o app"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/set_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9AA4AE"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#2A323A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Preferências do player"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Áudio preferido (dublado/original)" android:textColor="#3DA9FC" />
        <Spinner android:id="@+id/set_audio_lang" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Legenda preferida" android:textColor="#3DA9FC" />
        <Spinner android:id="@+id/set_sub_lang" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Tamanho da legenda" android:textColor="#3DA9FC" />
        <Spinner android:id="@+id/set_sub_size" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Aspecto padrão" android:textColor="#3DA9FC" />
        <Spinner android:id="@+id/set_aspect" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Qualidade da conexão (início mais alto)" android:textColor="#3DA9FC" />
        <Spinner android:id="@+id/set_conn" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <CheckBox android:id="@+id/set_force_max" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Travar sempre na máxima qualidade" android:textColor="#FFFFFF" />
        <CheckBox android:id="@+id/set_resume" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Continuar de onde parou" android:textColor="#FFFFFF" />
        <CheckBox android:id="@+id/set_retry" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reconectar automaticamente em falha" android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/set_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salvar" />

            <Button
                android:id="@+id/set_load_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Carregar agora" />

            <Button
                android:id="@+id/set_clear_cache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Limpar cache" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
