<?xml version="1.0" encoding="utf-8"?>
<!-- Abertura: marca no fundo da marca. Fica poucos instantes (espera só a pré-carga rápida). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper_landimflix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="170dp"
            android:adjustViewBounds="true"
            android:contentDescription="Landimflix"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_full" />

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="22dp"
            android:indeterminateTint="@color/lf_accent" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Preparando seu catálogo…"
            android:textColor="@color/lf_text_2"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
