<resources>
    <style name="Theme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fontFamily">@font/nunito_sans</item>
        <item name="android:windowBackground">@color/lf_bg</item>
        <item name="colorAccent">@color/lf_accent</item>
        <item name="colorControlNormal">@color/lf_text_3</item>
        <item name="colorControlActivated">@color/lf_accent</item>
        <item name="colorControlHighlight">#33A85FDD</item>
        <item name="android:textColorHint">@color/lf_text_3</item>
        <item name="android:buttonStyle">@style/TvButton</item>
        <item name="buttonStyle">@style/TvButton</item>
        <item name="android:editTextStyle">@style/TvEditText</item>
        <item name="editTextStyle">@style/TvEditText</item>
        <item name="android:spinnerStyle">@style/TvSpinner</item>
        <item name="spinnerStyle">@style/TvSpinner</item>
        <!-- Todos os diálogos (AppCompat) usam o tema escuro arredondado -->
        <item name="alertDialogTheme">@style/Theme.Player.Dialog</item>
    </style>

    <!-- Campo de texto: card arredondado, borda azul ao focar -->
    <style name="TvEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textColor">@color/lf_text</item>
        <item name="android:textColorHint">@color/lf_text_3</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <!-- Formulário (tela de entrada): rótulo acima do campo; campo com 48dp, como manda o DESIGN.md -->
    <style name="FormLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textColor">@color/lf_text_2</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FormField" parent="TvEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Item do dock do player (estilo dock do Mac) -->
    <style name="DockItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textColor">@color/card_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Chip de temporada / dublado-legendado (estilo Apple TV) -->
    <style name="SeasonChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textColor">@color/card_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- Tecla do teclado da busca: foco = anel, como os demais botões -->
    <style name="SearchKey">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textColor">@color/card_text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Título de uma fileira de resultados ("Filmes · 124") -->
    <style name="SearchSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textColor">@color/lf_accent</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Botão de ação principal em forma de texto: o roxo cheio, um por tela -->
    <style name="PrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/btn_primary_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="SearchRetry" parent="PrimaryButton" />

    <!-- Botão secundário: só o anel de foco, sem preenchimento colorido -->
    <style name="GhostButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textColor">@color/card_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>

    <!-- Botão da barra de toque do player (celular): alvo de pelo menos 48dp, sem foco -->
    <style name="TouchBarButton" parent="GhostButton">
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:focusable">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <!-- Pílula (temporada, dublado/legendado): ativa = fundo claro e texto no acento -->
    <style name="PillChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/nav_tab_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textColor">@color/nav_tab_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Lista suspensa (spinner) com fundo escuro arredondado -->
    <style name="TvSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/dialog_bg</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <!-- Diálogos/menus no estilo do app (escuro, arredondado, destaque azul) -->
    <style name="Theme.Player.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorAccent">@color/lf_accent</item>
        <item name="android:textColorPrimary">@color/lf_text</item>
        <item name="android:textColorSecondary">@color/lf_text_2</item>
        <item name="android:textColorAlertDialogListItem">@color/lf_text</item>
        <item name="android:windowTitleStyle">@style/Player.DialogTitle</item>
    </style>

    <style name="Player.DialogTitle" parent="@android:style/TextAppearance.DialogWindowTitle">
        <item name="android:textColor">@color/lf_text</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Menu suspenso (PopupMenu) escuro -->
    <style name="Theme.Player.Popup" parent="Theme.AppCompat">
        <item name="android:popupBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/lf_text</item>
        <item name="colorAccent">@color/lf_accent</item>
    </style>

    <!-- Botão padrão da TV: seleção por preenchimento sólido, sem círculo nem zoom -->
    <style name="TvButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:textColor">@color/card_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Botão principal da tela (um por tela): roxo cheio, texto branco -->
    <style name="TvButton.Primary" parent="TvButton">
        <item name="android:background">@drawable/btn_primary_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
    </style>

    <!-- Aba da barra superior (TV ao vivo / Filmes / Séries / Favoritos / Buscar) -->
    <style name="NavTab" parent="TvButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/nav_tab_bg</item>
        <item name="android:textColor">@color/nav_tab_text</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
